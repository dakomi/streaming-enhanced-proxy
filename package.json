{
  "name": "streaming-enhanced-proxy",
  "version": "1.0.0",
  "description": "Self-hosted LAN proxy that injects Streaming Enhanced scripts into streaming service pages",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-admin",
    "copy-admin": "node -e \"const fs=require('fs');const p=require('path');const src='src/server/admin';const dst='dist/server/admin';if(!fs.existsSync(dst))fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(p.join(src,f),p.join(dst,f)));\"",
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.1.0",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "fastify": "^5.7.2",
    "http-mitm-proxy": "^1.1.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
